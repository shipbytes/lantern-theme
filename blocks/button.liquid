{%- if block.settings.label != blank -%}
  <div {{ block.shopify_attributes }}>
    <a href="{{ block.settings.link | default: '#' }}" class="btn {% if block.settings.style == 'ghost' %}btn-ghost{% endif %}">{{ block.settings.label | escape }}</a>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Button",
  "tag": null,
  "settings": [
    { "type": "text", "id": "label", "label": "Label", "default": "Meet the makers" },
    { "type": "url", "id": "link", "label": "Link" },
    {
      "type": "select",
      "id": "style",
      "label": "Style",
      "options": [
        { "value": "solid", "label": "Solid" },
        { "value": "ghost", "label": "Outline" }
      ],
      "default": "ghost"
    }
  ],
  "presets": [{ "name": "Button" }]
}
{% endschema %}
