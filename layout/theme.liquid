<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>
    {{- page_title -}}
    {%- if current_page != 1 %} &ndash; {{ 'general.pagination.page' | t: page: current_page }}{% endif -%}
    {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
  </title>
  {%- if page_description -%}<meta name="description" content="{{ page_description | escape }}">{%- endif -%}
  <link rel="canonical" href="{{ canonical_url }}">

  {%- liquid
    assign heading_font = settings.font_heading
    assign heading_font_heavy = heading_font | font_modify: 'weight', '+100'
    assign body_font = settings.font_body
    assign body_font_bold = body_font | font_modify: 'weight', 'bold'
    assign body_font_italic = body_font | font_modify: 'style', 'italic'
  -%}
  {%- comment -%}
    Fonts first, before content_for_header, so a streamed page meets them early. A system
    font has no files: font_url returns nothing for it, so every tag that would request a
    file is guarded with `system?`. font_face returns nothing for system fonts, so it needs
    no guard.
  {%- endcomment -%}
  {%- unless heading_font.system? and body_font.system? -%}
    <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>
  {%- endunless -%}
  {%- unless heading_font.system? -%}{{ heading_font | font_url | preload_tag: as: 'font', type: 'font/woff2' }}{%- endunless -%}
  {%- unless body_font.system? -%}{{ body_font | font_url | preload_tag: as: 'font', type: 'font/woff2' }}{%- endunless -%}

  {%- comment -%}
    Theme settings become CSS variables here; Tailwind's tokens in src/theme.css read them,
    so a colour or font changed in the theme editor changes every utility that uses it.
  {%- endcomment -%}
  {% style %}
    {{ heading_font | font_face: font_display: 'swap' }}
    {{ heading_font_heavy | font_face: font_display: 'swap' }}
    {{ body_font | font_face: font_display: 'swap' }}
    {{ body_font_bold | font_face: font_display: 'swap' }}
    {{ body_font_italic | font_face: font_display: 'swap' }}
    :root {
      --lantern-ground: {{ settings.color_ground }};
      --lantern-ground-2: {{ settings.color_ground_2 }};
      --lantern-ink: {{ settings.color_ink }};
      --lantern-ink-2: {{ settings.color_ink_2 }};
      --lantern-line: {{ settings.color_line }};
      --lantern-accent: {{ settings.color_accent }};
      --lantern-on-accent: {{ settings.color_on_accent }};
      --lantern-font-heading: {{ heading_font.family }}, {{ heading_font.fallback_families }};
      --lantern-font-heading-weight: {{ heading_font.weight }};
      --lantern-font-body: {{ body_font.family }}, {{ body_font.fallback_families }};
      --lantern-heading-scale: {{ settings.heading_scale | divided_by: 100.0 }};
      --lantern-card-ratio: {{ settings.card_ratio }};
    }
  {% endstyle %}
  {{ 'theme.css' | asset_url | stylesheet_tag }}

  {{ content_for_header }}
</head>
<body class="min-h-screen flex flex-col bg-ground text-ink antialiased">
  <a href="#MainContent" class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-50 focus:bg-ink focus:text-ground focus:px-4 focus:py-2 focus:rounded-full">{{ 'accessibility.skip_to_content' | t }}</a>

  {% sections 'header-group' %}

  <main id="MainContent" class="flex-1" role="main" tabindex="-1">
    {{ content_for_layout }}
  </main>

  {% sections 'footer-group' %}

  <script src="{{ 'theme.js' | asset_url }}" defer></script>
</body>
</html>
