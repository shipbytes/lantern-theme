<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ shop.name }}</title>
  <style>:root{--lantern-ground:{{ settings.color_ground }};--lantern-ground-2:{{ settings.color_ground_2 }};--lantern-ink:{{ settings.color_ink }};--lantern-ink-2:{{ settings.color_ink_2 }};--lantern-line:{{ settings.color_line }};--lantern-accent:{{ settings.color_accent }};--lantern-on-accent:{{ settings.color_on_accent }};--lantern-font-heading:ui-sans-serif,system-ui,sans-serif;--lantern-font-body:ui-sans-serif,system-ui,sans-serif}</style>
  {{ 'theme.css' | asset_url | stylesheet_tag }}
  {{ content_for_header }}
</head>
<body class="min-h-screen flex flex-col bg-ground text-ink antialiased">
  <main id="MainContent" class="flex-1" role="main">{{ content_for_layout }}</main>
</body>
</html>
