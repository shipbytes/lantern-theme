<section class="wrap py-12">
  <div class="grid gap-8 md:grid-cols-[5fr_7fr] items-stretch">
    <div class="flex flex-col justify-center gap-5 py-6">
      {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow | escape }}</span>{%- endif -%}
      <h1 class="text-5xl md:text-[56px] leading-[1.02] font-extrabold">{{ section.settings.heading | escape }}</h1>
      {%- if section.settings.text != blank -%}<p class="text-lg leading-relaxed text-ink-2 max-w-[44ch]">{{ section.settings.text | escape }}</p>{%- endif -%}
      <div class="flex flex-wrap gap-3">
        {%- if section.settings.button_label != blank -%}<a class="btn" href="{{ section.settings.button_link }}">{{ section.settings.button_label | escape }}</a>{%- endif -%}
        {%- if section.settings.button_2_label != blank -%}<a class="btn btn-ghost" href="{{ section.settings.button_2_link }}">{{ section.settings.button_2_label | escape }}</a>{%- endif -%}
      </div>
    </div>
    <div class="rounded-tile overflow-hidden bg-ground-2 min-h-[320px] md:min-h-[520px]">
      {%- if section.settings.image != blank -%}
        {{ section.settings.image | image_url: width: 1600 | image_tag: class: 'w-full h-full object-cover', widths: '600, 900, 1200, 1600', sizes: '(min-width: 768px) 58vw, 100vw' }}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "New this season" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Light your evenings slowly." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Hand-poured candles, brass lanterns and linen for the hours after sunset." },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop the collection" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "text", "id": "button_2_label", "label": "Second button label" },
    { "type": "url", "id": "button_2_link", "label": "Second button link" }
  ],
  "presets": [{ "name": "Hero" }]
}
{% endschema %}
