{%- liquid
  assign collection = section.settings.collection
  assign limit = section.settings.products_to_show
-%}
<section class="wrap py-10 md:py-14 flex flex-col gap-6">
  <div class="flex flex-wrap items-end justify-between gap-4">
    <div class="flex flex-col gap-2">
      {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow | escape }}</span>{%- endif -%}
      <h2 class="text-[30px] font-bold">{{ section.settings.heading | default: collection.title | escape }}</h2>
    </div>
    {%- if section.settings.show_all and collection != blank -%}
      <a href="{{ collection.url }}" class="font-semibold border-b border-current pb-0.5 hover:text-accent">{{ 'sections.featured_collection.view_all' | t }}</a>
    {%- endif -%}
  </div>
  <ul class="grid grid-cols-2 md:grid-cols-4 gap-6" role="list">
    {%- for product in collection.products limit: limit -%}
      <li>{% render 'product-card', product: product %}</li>
    {%- else -%}
      {%- for i in (1..limit) -%}
        <li><div class="aspect-card rounded-[14px] overflow-hidden bg-ground-2">{{ 'product-' | append: i | placeholder_svg_tag: 'w-full h-full object-cover opacity-60' }}</div></li>
      {%- endfor -%}
    {%- endfor -%}
  </ul>
</section>

{% schema %}
{
  "name": "Featured collection",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Featured" },
    { "type": "text", "id": "heading", "label": "Heading", "info": "Leave empty to use the collection's title." },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "products_to_show", "label": "Products to show", "min": 4, "max": 12, "step": 4, "default": 4 },
    { "type": "checkbox", "id": "show_all", "label": "Show \"View all\" link", "default": true }
  ],
  "presets": [{ "name": "Featured collection" }]
}
{% endschema %}
