<section class="wrap py-24 flex flex-col items-center gap-6 text-center">
  <h1 class="text-[40px] font-extrabold">{{ 'general.password.title' | t }}</h1>
  {%- if shop.password_message != blank -%}<p class="text-ink-2 max-w-[50ch]">{{ shop.password_message }}</p>{%- endif -%}
  {%- form 'storefront_password', class: 'flex gap-3' -%}
    <label for="Password" class="sr-only">{{ 'general.password.label' | t }}</label>
    <input id="Password" type="password" name="password" class="min-h-12 rounded-full border border-line bg-white px-5" placeholder="{{ 'general.password.label' | t }}">
    <button type="submit" class="btn">{{ 'general.password.submit' | t }}</button>
    {%- if form.errors -%}<p class="text-sm text-[#B42318]">{{ form.errors.messages['form'] }}</p>{%- endif -%}
  {%- endform -%}
</section>
{% schema %}
{ "name": "Password", "settings": [] }
{% endschema %}
