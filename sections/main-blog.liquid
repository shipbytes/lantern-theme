<section class="wrap py-8 flex flex-col gap-6">
  <h1 class="text-[40px] font-extrabold">{{ blog.title }}</h1>
  {%- paginate blog.articles by 12 -%}
    <ul class="grid md:grid-cols-3 gap-6" role="list">
      {%- for article in blog.articles -%}
        <li><a href="{{ article.url }}" class="block group">
          <div class="aspect-[4/3] rounded-[14px] overflow-hidden bg-ground-2">{%- if article.image -%}{{ article.image | image_url: width: 800 | image_tag: class: 'w-full h-full object-cover', loading: 'lazy' }}{%- endif -%}</div>
          <h2 class="mt-3 font-semibold group-hover:text-accent">{{ article.title }}</h2>
          <p class="text-sm text-ink-2 mt-1">{{ article.published_at | date: format: 'date' }}</p>
        </a></li>
      {%- endfor -%}
    </ul>
    {% render 'pagination', paginate: paginate %}
  {%- endpaginate -%}
</section>
{% schema %}
{ "name": "Blog", "settings": [] }
{% endschema %}
