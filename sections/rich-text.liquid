{%- comment -%} The same blocks as image-with-text, in a single column. {%- endcomment -%}
<section class="wrap py-14 md:py-16">
  <div class="flex flex-col gap-4 {% if section.settings.align == 'center' %}items-center text-center{% endif %} max-w-[640px] {% if section.settings.align == 'center' %}mx-auto{% endif %}">
    {% content_for 'blocks' %}
  </div>
</section>

{% schema %}
{
  "name": "Rich text",
  "settings": [
    {
      "type": "select",
      "id": "align",
      "label": "Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Centre" }
      ],
      "default": "left"
    }
  ],
  "blocks": [{ "type": "@theme" }, { "type": "@app" }],
  "presets": [
    {
      "name": "Rich text",
      "blocks": [
        { "type": "heading", "settings": { "text": "Objects for the evening.", "size": "lg" } },
        { "type": "text", "settings": { "text": "<p>Candles, lanterns and linen for the hours after sunset, made in small batches across Rajasthan and Gujarat.</p>" } }
      ]
    }
  ]
}
{% endschema %}
