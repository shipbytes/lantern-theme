{%- comment -%}
  The collection page. Part 2: sorting through the sort_by parameter the way Shopify expects,
  a count, the grid of product cards and pagination (the snippet, since part 5).
{%- endcomment -%}
{%- liquid
  assign sort_by = collection.sort_by | default: collection.default_sort_by
-%}
<section class="wrap py-8 flex flex-col gap-6">
  <nav aria-label="Breadcrumb" class="text-[13px] text-ink-2 flex gap-2">
    <a href="{{ routes.root_url }}" class="hover:text-ink">{{ 'general.breadcrumbs.home' | t }}</a><span aria-hidden="true">/</span><span>{{ collection.title }}</span>
  </nav>
  <div class="flex flex-wrap items-end justify-between gap-4">
    <div class="flex flex-col gap-2">
      <h1 class="text-[40px] font-extrabold">{{ collection.title }}</h1>
      {%- if collection.description != blank -%}<div class="text-ink-2 max-w-[60ch] leading-relaxed">{{ collection.description }}</div>{%- endif -%}
    </div>
    <p class="text-sm text-ink-2">{{ 'collections.general.products_count' | t: count: collection.products_count }}</p>
  </div>

  <form method="get" action="{{ collection.url }}" class="flex items-center gap-3 text-sm self-end">
    <label for="SortBy">{{ 'collections.sorting.title' | t }}</label>
    <select id="SortBy" name="sort_by" class="min-h-11 rounded-full border border-line bg-white px-4">
      {%- for option in collection.sort_options -%}
        <option value="{{ option.value }}" {% if option.value == sort_by %}selected{% endif %}>{{ option.name }}</option>
      {%- endfor -%}
    </select>
    <noscript><button type="submit" class="btn btn-ghost min-h-11">{{ 'collections.sorting.apply' | t }}</button></noscript>
  </form>

  {%- paginate collection.products by section.settings.per_page -%}
    {%- if collection.products.size == 0 -%}
      <p class="text-ink-2">{{ 'collections.general.empty' | t }}</p>
    {%- else -%}
      <ul class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-x-6 gap-y-10" role="list">
        {%- for product in collection.products -%}
          {%- liquid
            if forloop.index <= 4
              assign loading = 'eager'
            else
              assign loading = 'lazy'
            endif
          -%}
          <li>{% render 'product-card', product: product, loading: loading %}</li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
    {% render 'pagination', paginate: paginate %}
  {%- endpaginate -%}
</section>

{% schema %}
{
  "name": "Collection",
  "settings": [
    { "type": "range", "id": "per_page", "label": "Products per page", "min": 8, "max": 48, "step": 4, "default": 12 }
  ]
}
{% endschema %}
