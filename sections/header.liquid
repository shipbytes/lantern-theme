{%- comment -%}
  The site header: shop name or logo, the main menu from Navigation in the admin, and the
  search, account and cart icons. `cart.item_count` is live on every page because the
  cart is part of the request; the drawer that opens from the icon comes in part 4.
{%- endcomment -%}
<header class="bg-ground border-b border-line {% if section.settings.sticky %}sticky top-0 z-40{% endif %}" data-header-section="{{ section.id }}">
  <div class="wrap flex items-center justify-between gap-4 h-[72px]">
    <a href="{{ routes.root_url }}" class="font-heading font-extrabold text-[22px] tracking-tight">
      {%- if section.settings.logo != blank -%}
        {{ section.settings.logo | image_url: width: 300 | image_tag: width: section.settings.logo_width, class: 'h-auto', alt: shop.name }}
      {%- else -%}
        {{ shop.name }}
      {%- endif -%}
    </a>

    {%- liquid
      assign menu = linklists[section.settings.menu]
    -%}
    <nav class="hidden md:flex gap-1" aria-label="{{ 'general.navigation.main' | t }}">
      {%- for link in menu.links -%}
        <a href="{{ link.url }}" class="text-[15px] font-medium px-3 py-2.5 rounded-full hover:bg-ground-2 {% if link.current %}underline underline-offset-4{% endif %}" {% if link.current %}aria-current="page"{% endif %}>{{ link.title }}</a>
      {%- endfor -%}
    </nav>

    <div class="flex items-center gap-1">
      <predictive-search data-url="{{ routes.predictive_search_url }}">
        <a href="{{ routes.search_url }}" class="icon-btn" data-search-open aria-label="{{ 'general.search.search' | t }}">{% render 'icon', name: 'search' %}</a>
        <dialog id="SearchDialog" class="fixed inset-x-0 top-0 bottom-auto m-0 w-full max-w-none max-h-[90dvh] overflow-y-auto bg-ground text-ink p-0 shadow-xl backdrop:bg-ink/40" aria-label="{{ 'general.search.search' | t }}">
          <div class="wrap py-6 flex flex-col gap-5">
            <form action="{{ routes.search_url }}" method="get" role="search" class="flex gap-3">
              <label for="SearchInput" class="sr-only">{{ 'general.search.search' | t }}</label>
              <input id="SearchInput" type="search" name="q" autocomplete="off" placeholder="{{ 'general.search.placeholder' | t }}" class="flex-1 min-h-12 rounded-full border border-line bg-white px-5" aria-controls="PredictiveResults" aria-expanded="false">
              <input type="hidden" name="options[prefix]" value="last">
              <button type="submit" class="btn">{{ 'general.search.search' | t }}</button>
              <button type="button" class="icon-btn shrink-0" data-search-close aria-label="{{ 'accessibility.close' | t }}">{% render 'icon', name: 'close' %}</button>
            </form>
            <div id="PredictiveResults" aria-live="polite"></div>
          </div>
        </dialog>
      </predictive-search>
      {%- if shop.customer_accounts_enabled -%}
        {%- liquid
          if customer
            assign account_label = 'customer.account.greeting' | t: name: customer.first_name
          else
            assign account_label = 'customer.account.title' | t
          endif
        -%}
        <a href="{{ routes.account_url }}" class="icon-btn" aria-label="{{ account_label }}" title="{{ account_label }}">{% render 'icon', name: 'account' %}</a>
      {%- endif -%}
      <a href="{{ routes.cart_url }}" class="icon-btn" data-cart-link aria-label="{{ 'cart.general.title' | t }}, {{ 'cart.general.item_count' | t: count: cart.item_count }}">
        {% render 'icon', name: 'cart' %}
        <span class="absolute top-1 right-1 min-w-[18px] h-[18px] px-1.5 rounded-full bg-accent text-on-accent text-[11px] font-semibold flex items-center justify-center {% if cart.item_count == 0 %}hidden{% endif %}" data-cart-count>{{ cart.item_count }}</span>
      </a>
    </div>
  </div>
</header>

{% schema %}
{
  "name": "Header",
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "Logo" },
    { "type": "range", "id": "logo_width", "label": "Logo width", "min": 60, "max": 240, "step": 10, "unit": "px", "default": 120 },
    { "type": "link_list", "id": "menu", "label": "Menu", "default": "main-menu" },
    { "type": "checkbox", "id": "sticky", "label": "Stick to the top while scrolling", "default": true }
  ]
}
{% endschema %}
