{%- comment -%}
  {% form 'customer' %} creates a customer with the "newsletter" tag and marketing consent;
  no app needed. After a POST the same page renders again with `form` filled in.
{%- endcomment -%}
<section class="wrap py-14 md:py-16">
  <div class="max-w-[560px] flex flex-col gap-3.5">
    <h2 class="text-[30px] font-bold">{{ section.settings.heading | escape }}</h2>
    {%- if section.settings.text != blank -%}<p class="text-ink-2 leading-relaxed">{{ section.settings.text | escape }}</p>{%- endif -%}
    {%- form 'customer', class: 'flex flex-col gap-3 mt-1.5', id: 'NewsletterForm' -%}
      {%- if form.posted_successfully? -%}
        <p class="font-semibold text-accent" role="status">{{ 'sections.newsletter.success' | t }}</p>
      {%- else -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <div class="flex flex-wrap gap-2.5">
          <label for="NewsletterEmail" class="sr-only">{{ 'sections.newsletter.email' | t }}</label>
          <input id="NewsletterEmail" type="email" name="contact[email]" required autocomplete="email" placeholder="{{ 'sections.newsletter.placeholder' | t }}" class="flex-1 basis-[260px] min-h-12 px-4 rounded-full border border-line bg-white" {% if form.errors %}aria-invalid="true" aria-describedby="NewsletterError"{% endif %}>
          <button type="submit" class="btn">{{ section.settings.button_label | escape }}</button>
        </div>
        {%- if form.errors -%}
          <p id="NewsletterError" class="text-sm text-[#B42318]">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</p>
        {%- endif -%}
      {%- endif -%}
    {%- endform -%}
  </div>
</section>

{% schema %}
{
  "name": "Newsletter",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "New pieces, once a month." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "One email when a new batch is ready. No sales pressure, no daily sends." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Subscribe" }
  ],
  "presets": [{ "name": "Newsletter" }]
}
{% endschema %}
