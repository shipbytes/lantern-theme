{%- comment -%}
  {% render 'pagination', paginate: paginate %} inside a {% paginate %} block.
  paginate.parts is the list Shopify already computed: page numbers, the current one, and
  an ellipsis ("…") where pages are skipped. The previous and next links carry rel so
  crawlers and browsers understand the sequence.
{%- endcomment -%}
{%- if paginate.pages > 1 -%}
  <nav class="flex justify-center items-center gap-1 pt-4" aria-label="{{ 'general.pagination.label' | t }}">
    {%- if paginate.previous -%}
      <a href="{{ paginate.previous.url }}" rel="prev" class="icon-btn" aria-label="{{ 'general.pagination.previous' | t }}"><span class="rotate-180 inline-flex">{% render 'icon', name: 'arrow' %}</span></a>
    {%- endif -%}
    {%- for part in paginate.parts -%}
      {%- if part.is_link -%}
        <a href="{{ part.url }}" class="inline-flex items-center justify-center min-w-11 h-11 rounded-full font-semibold text-sm hover:bg-ground-2" aria-label="{{ 'general.pagination.page' | t: page: part.title }}">{{ part.title }}</a>
      {%- elsif part.title == paginate.current_page -%}
        <span aria-current="page" class="inline-flex items-center justify-center min-w-11 h-11 rounded-full font-semibold text-sm bg-ink text-ground">{{ part.title }}</span>
      {%- else -%}
        <span class="inline-flex items-center justify-center min-w-11 h-11 text-sm text-ink-2" aria-hidden="true">{{ part.title }}</span>
      {%- endif -%}
    {%- endfor -%}
    {%- if paginate.next -%}
      <a href="{{ paginate.next.url }}" rel="next" class="icon-btn" aria-label="{{ 'general.pagination.next' | t }}">{% render 'icon', name: 'arrow' %}</a>
    {%- endif -%}
  </nav>
{%- endif -%}
