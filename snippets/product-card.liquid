{%- comment -%} One product in a grid. {% render 'product-card', product: product, loading: 'lazy' %} {%- endcomment -%}
{%- liquid
  assign loading = loading | default: 'lazy'
  assign second = product.media[1]
  assign on_sale = false
  if product.compare_at_price > product.price
    assign on_sale = true
  endif
-%}
<a href="{{ product.url }}" class="block group">
  <div class="relative aspect-card rounded-[14px] overflow-hidden bg-ground-2">
    {%- if product.featured_image -%}
      {{ product.featured_image | image_url: width: 800 | image_tag: class: 'w-full h-full object-cover transition-opacity duration-300', widths: '400, 600, 800', sizes: '(min-width: 1024px) 25vw, (min-width: 768px) 33vw, 50vw', loading: loading }}
      {%- if settings.card_hover and second and second.media_type == 'image' -%}
        {{ second | image_url: width: 800 | image_tag: class: 'absolute inset-0 w-full h-full object-cover opacity-0 group-hover:opacity-100 transition-opacity duration-300', widths: '400, 600, 800', sizes: '(min-width: 1024px) 25vw, (min-width: 768px) 33vw, 50vw', loading: 'lazy', alt: '' }}
      {%- endif -%}
    {%- endif -%}
    {%- unless product.available -%}
      <span class="absolute top-3 left-3 rounded-full bg-ground px-2.5 py-1 text-[11px] font-semibold tracking-[0.06em] uppercase">{{ 'products.product.sold_out' | t }}</span>
    {%- elsif on_sale -%}
      <span class="absolute top-3 left-3 rounded-full bg-ground px-2.5 py-1 text-[11px] font-semibold tracking-[0.06em] uppercase">{{ 'products.product.on_sale' | t }}</span>
    {%- endunless -%}
  </div>
  <h3 class="mt-3 text-base font-semibold leading-snug group-hover:text-accent">{{ product.title }}</h3>
  <p class="mt-1">{% render 'price', product: product %}</p>
</a>
