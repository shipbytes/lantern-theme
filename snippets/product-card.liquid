{%- comment -%} One product in a grid. {% render 'product-card', product: product %} {%- endcomment -%}
<a href="{{ product.url }}" class="block group">
  <div class="aspect-[4/5] rounded-[14px] overflow-hidden bg-ground-2">
    {%- if product.featured_image -%}
      {{ product.featured_image | image_url: width: 800 | image_tag: class: 'w-full h-full object-cover group-hover:scale-[1.02] transition-transform', widths: '400, 600, 800', sizes: '(min-width: 1024px) 25vw, (min-width: 768px) 33vw, 50vw', loading: 'lazy' }}
    {%- endif -%}
  </div>
  <h3 class="mt-3 text-base font-semibold leading-snug group-hover:text-accent">{{ product.title }}</h3>
  <p class="mt-1 text-sm text-ink-2">
    {%- if product.compare_at_price > product.price -%}
      <span class="text-[#B42318]">{{ product.price | money }}</span> <s class="text-ink-2/70">{{ product.compare_at_price | money }}</s>
    {%- elsif product.price_varies -%}
      {{ product.price_min | money }} &ndash; {{ product.price_max | money }}
    {%- else -%}
      {{ product.price | money }}
    {%- endif -%}
  </p>
</a>
