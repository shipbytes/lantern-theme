{%- comment -%}
  One product in a grid. {% render 'product-card', product: product, loading: 'lazy', heading: 'h3' %}
  `heading` is the level the title should have where the card sits: h2 on a page whose only
  heading above it is the h1, h3 under a section heading. `preload` marks the page's LCP image, which gets fetchpriority=high.
{%- endcomment -%}
{%- liquid
  assign loading = loading | default: 'lazy'
  assign heading = heading | default: 'h3'
  assign preload = preload | default: false
  assign second = product.media[1]
  assign on_sale = false
  if product.compare_at_price > product.price
    assign on_sale = true
  endif
-%}
<a href="{{ product.url }}" class="block group">
  <div class="relative aspect-card rounded-[14px] overflow-hidden bg-ground-2">
    {%- if product.featured_image -%}
      {%- if preload -%}
        {{ product.featured_image | image_url: width: 800 | image_tag: class: 'w-full h-full object-cover transition-opacity duration-300', widths: '300, 400, 600, 800', sizes: '(min-width: 1320px) 310px, (min-width: 1024px) 25vw, (min-width: 768px) 33vw, calc(50vw - 36px)', loading: 'eager', fetchpriority: 'high' }}
      {%- else -%}
        {{ product.featured_image | image_url: width: 800 | image_tag: class: 'w-full h-full object-cover transition-opacity duration-300', widths: '300, 400, 600, 800', sizes: '(min-width: 1320px) 310px, (min-width: 1024px) 25vw, (min-width: 768px) 33vw, calc(50vw - 36px)', loading: loading }}
      {%- endif -%}
      {%- if settings.card_hover and second and second.media_type == 'image' -%}
        {{ second | image_url: width: 800 | image_tag: class: 'absolute inset-0 w-full h-full object-cover opacity-0 group-hover:opacity-100 transition-opacity duration-300', widths: '300, 400, 600, 800', sizes: '(min-width: 1320px) 310px, (min-width: 1024px) 25vw, (min-width: 768px) 33vw, calc(50vw - 36px)', loading: 'lazy', alt: '' }}
      {%- endif -%}
    {%- endif -%}
    {%- unless product.available -%}
      <span class="absolute top-3 left-3 rounded-full bg-ground px-2.5 py-1 text-[11px] font-semibold tracking-[0.06em] uppercase">{{ 'products.product.sold_out' | t }}</span>
    {%- elsif on_sale -%}
      <span class="absolute top-3 left-3 rounded-full bg-ground px-2.5 py-1 text-[11px] font-semibold tracking-[0.06em] uppercase">{{ 'products.product.on_sale' | t }}</span>
    {%- endunless -%}
  </div>
  <{{ heading }} class="mt-3 text-base font-semibold leading-snug group-hover:text-accent">{{ product.title }}</{{ heading }}>
  <p class="mt-1">{% render 'price', product: product %}</p>
</a>
